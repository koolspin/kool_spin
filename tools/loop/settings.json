{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(tools/lint.sh)",
      "Bash(tools/lint.sh *)",
      "Bash(build/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git clean -fd)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": ["~/.cache/vcpkg"]
    },
    "network": {
      "allowedDomains": ["github.com", "*.github.com", "*.githubusercontent.com"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/loop/check-protected.sh",
            "args": ["--hook"]
          }
        ]
      }
    ]
  }
}
